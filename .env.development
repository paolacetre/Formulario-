# En desarrollo (npm start / npm run dev) el backend corre en el puerto 3000.
# VITE_API_URL vacío: el formulario pide /api al mismo servidor de Vite, que lo reenvía a API_PROXY_DESTINO
# (sin problemas de CORS, igual que Nginx en producción). Para llamar al backend directamente, pon aquí su URL.
VITE_API_URL=
API_PROXY_DESTINO=http://localhost:3000
