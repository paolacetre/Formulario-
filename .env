# Configuración del formulario (Vite solo expone las variables que empiezan por VITE_).
# Para cambios solo en tu equipo, usa .env.local (no se sube a git).

# Correo que se muestra en la confirmación: "Para más información, comuníquese al correo …".
# Correo de ejemplo mientras se confirma el institucional. Si queda vacío, el mensaje no se muestra.
VITE_CORREO_CONTACTO=correo@ejemplo.com

# Cómo se radican las solicitudes:
#   mock = simulado en el navegador (radicado consecutivo y fecha), mientras no hay acceso a la base de datos.
#   api  = backend del proyecto Clasificación de Ocupaciones (necesita el backend y la base de datos corriendo).
VITE_MODO_SOLICITUDES=mock

# URL del backend del proyecto Clasificación de Ocupaciones (solo para el modo api). Vacío = mismo servidor que el formulario
# (en producción Nginx envía /api al backend). En desarrollo se usa el valor de .env.development.
VITE_API_URL=
